{
  "name": "Sales Performance (navy / teal)",
  "dataColors": ["#1F3A5F", "#2A9D8F", "#E76F51", "#E9C46A", "#9AA5B1", "#5B7DB1", "#8AB17D", "#B56576"],
  "background": "#FFFFFF",
  "foreground": "#1F2D3D",
  "tableAccent": "#1F3A5F",
  "good": "#2A9D8F",
  "neutral": "#E9C46A",
  "bad": "#C0392B",
  "maximum": "#1F3A5F",
  "center": "#E9C46A",
  "minimum": "#E76F51",
  "textClasses": {
    "title":  { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F2D3D" },
    "label":  { "fontFace": "Segoe UI", "fontSize": 10, "color": "#5D6D7E" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#1F3A5F" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#D5D8DC" } }, "radius": 4 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1F2D3D" } }, "fontSize": 12 }]
      }
    },
    "page": { "*": { "background": [{ "color": { "solid": { "color": "#F4F6F8" } }, "transparency": 0 }] } }
  }
}
